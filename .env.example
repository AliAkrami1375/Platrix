# Copy to .env and adjust. All variables are optional.

# --- General ---
PLATRIX_LOG_LEVEL=INFO
PLATRIX_DEBUG=false

# --- Detection: "contour" (no weights) or "yolo" (needs weights) ---
PLATRIX_DETECTOR=contour
PLATRIX_YOLO_WEIGHTS=models/plate_yolo.pt
PLATRIX_DETECTION_CONFIDENCE=0.35

# --- OCR: "onnx" (needs models/ocr_cnn.onnx) · "cnn" (Keras) · "none" ---
PLATRIX_OCR=onnx
PLATRIX_ONNX_WEIGHTS=models/ocr_cnn.onnx
PLATRIX_OCR_WEIGHTS=models/ocr_cnn.h5

# --- Pipeline ---
PLATRIX_FRAME_STRIDE=1
PLATRIX_MAX_FPS=30
PLATRIX_DEDUPE_SECONDS=4

# --- Server ---
PLATRIX_HOST=0.0.0.0
PLATRIX_PORT=8080

# --- Auto-start a source when the server boots (optional) ---
# PLATRIX_DEFAULT_SOURCE=0
# PLATRIX_DEFAULT_SOURCE=rtsp://user:pass@192.168.1.50:554/stream
