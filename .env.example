# Copy to .env and adjust. All variables are optional.

# --- General ---
PLATRIX_LOG_LEVEL=INFO
PLATRIX_DEBUG=false

# --- Detection: "auto" (yolo if a model exists, else contour) | "yolo" | "contour" ---
PLATRIX_DETECTOR=auto
PLATRIX_YOLO_WEIGHTS=models/plate_yolo.pt
PLATRIX_DETECTION_CONFIDENCE=0.35

# --- OCR: "onnx" (needs models/ocr_cnn.onnx) · "cnn" (Keras) · "none" ---
PLATRIX_OCR=onnx
PLATRIX_ONNX_WEIGHTS=models/ocr_cnn.onnx
PLATRIX_OCR_WEIGHTS=models/ocr_cnn.h5

# --- Pipeline ---
PLATRIX_FRAME_STRIDE=1
PLATRIX_MAX_FPS=30
PLATRIX_DEDUPE_SECONDS=4

# --- Pipeline mode: "two-stage" (detector + reader, best) | "unified" (single
#     character-detection model — experimental, needs its own model) ---
PLATRIX_MODE=two-stage

# --- Server ---
PLATRIX_HOST=0.0.0.0
PLATRIX_PORT=8080

# --- Authentication (dashboard + API login) ---
PLATRIX_AUTH_ENABLED=true
PLATRIX_AUTH_USER=admin
PLATRIX_AUTH_PASSWORD=admin           # CHANGE THIS
PLATRIX_SECRET_KEY=set-a-long-random-string

# --- Auto-start a source when the server boots (optional) ---
# PLATRIX_DEFAULT_SOURCE=0
# PLATRIX_DEFAULT_SOURCE=rtsp://user:pass@192.168.1.50:554/stream
